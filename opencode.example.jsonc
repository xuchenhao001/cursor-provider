{
  "$schema": "https://opencode.ai/config.json",

  // Provider registration. The `aisdk:` prefix selects OpenCode's AI SDK path;
  // the `file://` form is imported directly by the host, so nothing is
  // npm-installed. Use an ABSOLUTE path, resolved through any symlink
  // (`realpath dist/index.js`) — the host imports exactly this specifier.
  //
  // `models` is optional: the plugin discovers Cursor's model list at runtime.
  // Pin entries here only if you want models to appear before discovery runs.
  "providers": {
    "cursor": {
      "package": "aisdk:file:///Users/chenhaoxu/Documents/git/opencode-cursor/dist/index.js",
      "name": "Cursor (caveman)"
    }
  },

  // The companion plugin: /connect credentials, the discovered catalog,
  // the Cursor-only tools, and the hooks the held-open Run transport needs.
  // It fills in `providers.cursor.package` too, so this entry alone is enough
  // for a working setup.
  //
  // A plugin entry must be a package DIRECTORY — pointing it at a .js file is
  // rejected with "configured plugin path must be a directory". For an absolute
  // directory the host resolves `<dir>/server.*` then `<dir>/index.*`, and does
  // NOT consult the package's exports map (that path is only taken for
  // npm-installed packages resolved by name). Hence this repo's root server.js,
  // a one-line re-export of dist/plugin.js. Relative paths resolve from here.
  "plugins": [
    "/Users/chenhaoxu/Documents/git/opencode-cursor"
  ]
}
