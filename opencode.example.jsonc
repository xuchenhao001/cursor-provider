{
  "$schema": "https://opencode.ai/config.json",

  // Provider registration. The `aisdk:` prefix selects OpenCode's AI SDK path;
  // the `file://` form is imported directly by the host, so nothing is
  // npm-installed. Use an ABSOLUTE path, resolved through any symlink
  // (`realpath dist/index.js`) — the host imports exactly this specifier.
  //
  // `models` is optional: the plugin discovers Cursor's model list at runtime.
  // Pin entries here only if you want models to appear before discovery runs.
  "providers": {
    "cursor": {
      "package": "aisdk:file:///Users/chenhaoxu/git/cursor-provider/dist/index.js",
      "name": "Cursor (caveman)"
    }
  },

  // Companion plugin: /connect credentials, model catalog, Exa web search, optional
  // Caveman MCP, and hooks for the held-open Run transport. It also fills in
  // `providers.cursor.package` when unset, so this entry alone is enough.
  //
  // Plugin entries must be a package DIRECTORY (or a `.ts`/`.js` file on newer
  // hosts). For a directory the host resolves `<dir>/server.*` then
  // `<dir>/index.*` and does not consult `package.json` exports — hence root
  // `server.js` re-exporting `dist/plugin.js`.
  "plugins": [
    {
      "package": "/Users/chenhaoxu/git/cursor-provider",
      "options": {
        // Optional override when `~/.caveman/bin/caveman-mcp` is not installed.
        // "cavemanMcpBin": "/absolute/path/to/caveman-mcp"
      }
    }
  ]

  // Caveman MCP: registered by the plugin when `caveman-mcp` exists (see
  // `CAVEMAN_MCP_BIN` or `options.cavemanMcpBin`). No `mcp.servers.caveman`
  // block is required. The `bash` fallback still needs caveman binaries on PATH.
}
