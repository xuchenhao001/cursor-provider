{
  "name": "cursor-provider",
  "version": "1.0.0",
  "description": "Personal OpenCode V2 Cursor provider with caveman-engine input compression",
  "type": "module",
  "license": "MIT",
  "author": "chenhaoxu",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cursor",
    "ai-sdk",
    "provider",
    "plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc && bun scripts/build-stamp.ts stamp",
    "typecheck": "tsc --noEmit",
    "check:dist": "bun scripts/build-stamp.ts check",
    "test": "bun test",
    "test:node-http2": "bun run build && node test/node-http2-cleanup.mjs",
    "test:watch": "bun test --watch",
    "tools:capture": "bun scripts/tool-schemas.ts capture",
    "tools:check": "bun scripts/tool-schemas.ts check",
    "verify": "bun run typecheck && bun run build && bun run check:dist && bun test && bun run tools:check",
    "generate:pricing": "bun run scripts/generate-cursor-pricing.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.15",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@tsconfig/node22": "^22.0.5",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
